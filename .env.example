# ─────────────────────────────────────────────
# apps/api/.env — copy this to apps/api/.env
# ─────────────────────────────────────────────

# PostgreSQL (Neon or Supabase connection string)
DATABASE_URL=postgresql://user:password@host:5432/formsy

# Upstash Redis
REDIS_URL=https://your-instance.upstash.io
REDIS_TOKEN=your_upstash_token

# GitHub OAuth App
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=your_64_char_hex_secret_here
JWT_REFRESH_SECRET=your_64_char_hex_refresh_secret_here

# Email
RESEND_API_KEY=re_your_resend_api_key
BREVO_API_KEY=your_brevo_api_key

# Polar Billing
POLAR_ACCESS_TOKEN=your_polar_access_token
POLAR_ORGANIZATION_ID=your_polar_organization_id
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret
POLAR_PRODUCT_ID_STARTER=your_starter_product_id
POLAR_PRODUCT_ID_PRO=your_pro_product_id
POLAR_PRODUCT_ID_MAX=your_max_product_id

# App URLs
FRONTEND_URL=http://localhost:5173
PORT=3001
NODE_ENV=development
